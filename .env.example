# --- Core ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=Shipyard
BASE_URL=http://localhost:8000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://shipyard:shipyard@localhost:5432/shipyard

# --- Redis (cache + arq broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
ACCESS_TOKEN_LIFETIME_SECONDS=3600
COOKIE_SECURE=false

# --- Email ---
EMAIL_BACKEND=console            # console | smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=no-reply@shipyard.local

# --- Stripe ---
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:8000/billing/success
STRIPE_CANCEL_URL=http://localhost:8000/billing/cancel
