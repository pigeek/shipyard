# --- Core ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=Shipyard
BASE_URL=http://localhost:8000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://shipyard:shipyard@localhost:5432/shipyard

# --- Redis (cache + arq broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Realtime (WebSocket / ASGI push; see app/core/realtime.py) ---
# "memory" is in-process (single worker); "redis" fans push out across workers.
REALTIME_PROVIDER=memory          # memory | redis

# --- Auth ---
ACCESS_TOKEN_LIFETIME_SECONDS=3600
REFRESH_TOKEN_LIFETIME_SECONDS=2592000   # 30 days (bearer refresh tokens)
COOKIE_SECURE=false
# Which auth transports this deployment accepts (ADR 0001). At least one must be
# true. Disable cookie for a bearer-only API (no CSRF surface, no SSR auth pages);
# disable bearer for a cookie-only (SSR/SPA) deployment.
AUTH_COOKIE_ENABLED=true
AUTH_BEARER_ENABLED=true

# --- i18n (see app/core/i18n.py) ---
# Source language (no catalog needed) and the locales the app negotiates to.
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en","fr"]

# --- CORS (separate-origin / Vite-dev SPA; comma/JSON list, empty = same-origin) ---
# Credentialed CORS needs explicit origins (no "*"). Cross-origin cookie sessions
# also require COOKIE_SECURE=true and a SameSite=None cookie (served over HTTPS).
CORS_ORIGINS=[]

# --- OAuth (social login; routes mounted only when both values are set) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Email ---
EMAIL_BACKEND=console            # console | smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=no-reply@shipyard.local

# --- Object storage (S3 / MinIO; see app/core/storage.py) ---
# "memory" keeps dev/tests infra-free (no boto3 calls, in-process); switch to
# "s3" for AWS S3 or MinIO. docker compose sets this to "s3" automatically.
STORAGE_PROVIDER=memory          # memory | s3
# For real AWS leave S3_ENDPOINT_URL empty. For MinIO point it at the API host.
S3_ENDPOINT_URL=                 # e.g. http://localhost:9000 for MinIO
# Host baked into presigned URLs handed to the browser. Set this when the API
# reaches the bucket at a different address than the browser does (e.g. compose:
# API -> http://minio:9000 but the browser -> http://localhost:9000).
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=shipyard
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
PRESIGNED_URL_TTL=3600           # presigned GET (download) expiry, seconds
UPLOAD_CREDENTIAL_TTL=600        # presigned POST (upload) expiry, seconds
MAX_UPLOAD_SIZE=10485760         # 10 MB ceiling enforced by the bucket policy
ORPHAN_UPLOAD_MAX_AGE=86400      # drop never-confirmed uploads after 24h

# --- Stripe ---
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:8000/billing/success
STRIPE_CANCEL_URL=http://localhost:8000/billing/cancel
